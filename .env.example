# Copia este archivo como .env y completa los valores. Nunca publiques el archivo .env.
PORT=8090
APP_BASE_URL=https://tu-dominio.cl
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR_POR_TU_ACCESS_TOKEN
# URL pública que Mercado Pago podrá llamar después de un pago.
MERCADOPAGO_WEBHOOK_URL=https://tu-dominio.cl/api/mercadopago/webhook
# Usa true solo con credenciales de prueba.
MERCADOPAGO_USE_SANDBOX=false
# Clave privada para la pantalla de validación de QR.
CHECKIN_SECRET=crea-una-clave-larga-y-privada
